# Environment Variables Example for GuardianLink Backend
# For local SQLite development (default):
DATABASE_URL=sqlite:///./guardianlink.db

# For Free Cloud PostgreSQL (Neon.tech or Supabase with PostGIS):
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/guardianlink?sslmode=require

SECRET_KEY=guardianlink_super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
